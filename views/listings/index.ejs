<% layout('layouts/boilerplate') %>

<style>
  #filters {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
  }
  .filter {
    text-align: center;
    margin-right: 2rem;
    margin-top: 2rem;
    opacity: 0.7;
  }
  .filter:hover {
    opacity: 1;
    cursor: pointer;
  }
  .filter a {
    color: inherit;
    text-decoration: none;
    display: block;
    padding-bottom: 0.25rem;
    border-bottom: 2px solid transparent;
  }
  .filter.active {
    opacity: 1;
  }
  .filter.active a {
    border-bottom-color: #222;
  }
  .filter p {
    font-size: 0.8rem;
    margin-bottom: 0;
  }
  .tax-info {
    display: none;
  }
  .tax-toggle {
    border: 1px solid black;
    border-radius: 1rem;
    height: 3.25rem;
    padding: 1rem;
    margin-left: 2rem;
    margin-top: 2rem;
    display: flex;
    align-items: center;
  }
</style>

<div id="filters">

  <% for (let cat of categories) { %>
    <div class="filter <%= activeCategory === cat.name ? 'active' : '' %>">
      <a href="/listings?category=<%= encodeURIComponent(cat.name) %>">
        <div><i class="<%= cat.icon %>"></i></div>
        <p><%= cat.name %></p>
      </a>
    </div>
  <% } %>

  <div class="tax-toggle">
    <div class="form-check-reverse form-switch">
      <input class="form-check-input" type="checkbox" role="switch" id="switchCheckDefault">
      <label class="form-check-label" for="switchCheckDefault">Display total after taxes</label>
    </div>
  </div>
</div>

<% if (activeCategory || q) { %>
  <div class="mt-3 d-flex align-items-center flex-wrap gap-2">
    <span class="text-muted">
      Showing
      <% if (activeCategory) { %><b><%= activeCategory %></b><% } else { %>results<% } %>
      <% if (q) { %> for "<b><%= q %></b>"<% } %>
      (<%= allListings.length %>)
    </span>
    <a href="/listings" class="btn btn-sm btn-outline-dark">Clear</a>
  </div>
<% } %>

<% if (allListings.length === 0) { %>
  <div class="text-center mt-5">
    <h5>No listings found</h5>
    <p class="text-muted">Try a different search or category.</p>
    <a href="/listings" class="btn btn-dark">View all listings</a>
  </div>
<% } %>

<div class="row row-cols-lg-3 row-cols-md-2 row-cols-sm-1 mt-3">

  <% for (let listing of allListings) { %>

    <a href="/listings/<%= listing._id %>" class="listing-link">

      <div class="card col listing-card">

        <img src="<%= listing.image && listing.image.url ? listing.image.url : listing.image %>"
             class="card-img-top"
             alt="listing_image"
             style="height: 20rem;">
        <div class="card-img-overlay"></div>
        <div class="card-body">
          <p class="card-text">
            <b><%= listing.title %></b><br>
            &#8377; <%= listing.price.toLocaleString("en-IN") %> /night
            <i class="tax-info"> &nbsp; &nbsp; +18% GST</i>
          </p>
        </div>

      </div>

    </a>

  <% } %>

</div>

<script>
  const taxSwitch = document.getElementById('switchCheckDefault');
  taxSwitch.addEventListener('click', () => {
    const taxInfo = document.getElementsByClassName('tax-info');
    for (const info of taxInfo) {
      info.style.display = taxSwitch.checked ? 'inline' : 'none';
    }
  });
</script>