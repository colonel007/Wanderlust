<% layout('layouts/boilerplate') %>
<script>
  const mapToken = "<%= process.env.MAP_TOKEN %>";
  const listing = <%- JSON.stringify(listing) %>;
</script>
<div class="row mt-3">

  <div class="col-8 offset-2">
    <h3><%= listing.title %></h3>
  </div>

  <div class="card col-6 offset-3 show-card listing-card">

    <img
      src="<%= listing.image && listing.image.url ? listing.image.url : listing.image %>"
      class="card-img-top show-img"
      alt="listing_image"
    >

    <div class="card-body">

      <p class="card-text">
        Owned by
        <i><%= listing.owner.username %></i>
      </p>

      <p class="card-text">
        <%= listing.description %>
      </p>

      <p class="card-text">
        &#8377; <%= listing.price.toLocaleString("en-IN") %>
      </p>

      <p class="card-text">
        <%= listing.location %>
      </p>

      <p class="card-text">
        <%= listing.country %>
      </p>

    </div>
  </div>

  <br>

  <% if(currentUser && currentUser._id.equals(listing.owner._id)) { %>

    <div class="btns">

      <a
        href="/listings/<%= listing._id %>/edit"
        class="btn btn-dark col-1 offset-3 edit-btn"
      >
        Edit
      </a>

      <form
        method="POST"
        action="/listings/<%= listing._id %>?_method=DELETE"
      >
        <button class="btn btn-dark offset-5">
          Delete
        </button>
      </form>

    </div>

  <% } %>


  <!-- REVIEW SECTION -->

  <div class="col-8 offset-3 mb-3">

    <hr>
    <h4>Leave a review</h4>

    <% if(currentUser) { %>

      <form
        id="review-form"
        action="/listings/<%= listing._id %>/reviews"
        method="POST"
        novalidate
        class="needs-validation"
      >

        <!-- STAR RATING -->

        <fieldset class="starability-slot">

          <legend>Rating:</legend>

          <!-- No rating (checked by default => all stars blank) -->
          <input
            type="radio"
            id="no-rate"
            class="input-no-rate"
            name="review[rating]"
            value="0"
            checked
            aria-label="No rating."
          />

          <!-- 1 star -->
          <input
            type="radio"
            id="first-rate1"
            name="review[rating]"
            value="1"
          />

          <label
            for="first-rate1"
            title="Terrible"
          >
            1 star
          </label>

          <!-- 2 stars -->
          <input
            type="radio"
            id="first-rate2"
            name="review[rating]"
            value="2"
          />

          <label
            for="first-rate2"
            title="Not good"
          >
            2 stars
          </label>

          <!-- 3 stars -->
          <input
            type="radio"
            id="first-rate3"
            name="review[rating]"
            value="3"
          />

          <label
            for="first-rate3"
            title="Average"
          >
            3 stars
          </label>

          <!-- 4 stars -->
          <input
            type="radio"
            id="first-rate4"
            name="review[rating]"
            value="4"
          />

          <label
            for="first-rate4"
            title="Very good"
          >
            4 stars
          </label>

          <!-- 5 stars -->
          <input
            type="radio"
            id="first-rate5"
            name="review[rating]"
            value="5"
          />

          <label
            for="first-rate5"
            title="Amazing"
          >
            5 stars
          </label>

        </fieldset>

        <div id="rating-error" class="text-danger small d-none">
          Please select a star rating.
        </div>


        <!-- COMMENT -->

        <div class="mb-3 mt-3">

          <label
            for="comment"
            class="form-label"
          >
            Comments
          </label>

          <textarea
            name="review[comment]"
            id="comment"
            cols="30"
            rows="5"
            class="form-control"
            required
          ></textarea>

          <div class="invalid-feedback">
            Please enter a comment.
          </div>

        </div>


        <!-- SUBMIT -->

        <button class="btn btn-outline-dark">
          Submit
        </button>

      </form>

      <hr>

    <% } %>


    <!-- ALL REVIEWS -->

    <% if(listing.reviews.length === 0) { %>

      <p>No reviews yet.</p>

    <% } %>

    <div class="row">

      <p><b>All Reviews</b></p>

      <% for(let review of listing.reviews) { %>

        <div class="card col-4 ms-3 mb-3">

          <div class="card-body">

            <h5 class="card-title">
              <%= review.author.username %>
            </h5>

            <p class="card-text">

              <span
                class="starability-result"
                data-rating="<%= review.rating %>"
                aria-label="<%= review.rating %> out of 5 stars"
              ></span>

            </p>

            <p class="card-text">
              <%= review.comment %>
            </p>

          </div>


          <!-- DELETE REVIEW -->

          <form
            class="mb-3"
            method="POST"
            action="/listings/<%= listing._id %>/reviews/<%= review._id %>?_method=DELETE"
          >

            <button class="btn btn-sm btn-dark">
              Delete
            </button>

          </form>

        </div>

      <% } %>

    </div>
  </div>

    <% if (listing.geometry && listing.geometry.coordinates) { %>

      <div class="col-6 offset-3 mb-3">

        <h3>Where you'll find us</h3>

        <div id="map"></div>

      </div>

    <% } %>
</div>

<% if (listing.geometry && listing.geometry.coordinates) { %>
  <script src="/js/map.js"></script>
<% } %>


<script>
  (() => {
    const form = document.getElementById('review-form');
    if (!form) return; // user not logged in => no form on the page

    const noRate = document.getElementById('no-rate');
    const error = document.getElementById('rating-error');

    form.addEventListener('submit', (event) => {
      if (noRate.checked) {
        event.preventDefault();
        event.stopPropagation();
        error.classList.remove('d-none');
      }
    });

    form.querySelectorAll('input[name="review[rating]"]').forEach((input) => {
      input.addEventListener('change', () => {
        if (!noRate.checked) error.classList.add('d-none');
      });
    });
  })();
</script>